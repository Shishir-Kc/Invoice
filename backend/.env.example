# Invoicely API (Hono on Cloudflare Workers + D1)
#
# Most config lives in wrangler.jsonc `vars`. Secrets go through
# `wrangler secret put <NAME>` — never put real secret values here.

# Legacy header-key auth for GET /auth. Unset = endpoint disabled (fail-closed).
LEGACY_ACCESS_KEY=change-me

# HYPER (Arcademia) auth base URL. (Also settable as a var in wrangler.jsonc.)
# HYPER_API_URL=https://api.arcademia.app

# Frontend origin, used to build invite join links (/join?token=...).
# FRONTEND_URL=https://shishirkhatri.com.np

# --- D1 (for drizzle-kit studio / remote tooling only) ---
# The Worker itself uses the `DB` binding from wrangler.jsonc, not these.
# CLOUDFLARE_ACCOUNT_ID=
# D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
