{
  "name": "invoicely-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typegen": "wrangler types",
    "db:create": "wrangler d1 create invoicely",
    "db:migrate:local": "wrangler d1 migrations apply invoicely --local",
    "db:migrate:remote": "wrangler d1 migrations apply invoicely --remote",
    "db:migrations:create": "wrangler d1 migrations create invoicely",
    "db:query:local": "wrangler d1 execute invoicely --local --command",
    "db:query:remote": "wrangler d1 execute invoicely --remote --command",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.41.0",
    "hono": "^4.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250630.0",
    "@types/node": "^26.0.1",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.105.0"
  }
}
