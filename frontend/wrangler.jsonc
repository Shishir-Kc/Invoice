{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "invoicely",
	"compatibility_date": "2026-06-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding for OpenNext incremental cache.
			// The service name MUST match the worker name ("invoicely").
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "invoicely"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// NEXT_PUBLIC_API_URL is a Next.js build-time var (inlined into the JS
	// bundle at build time). Set it in .env.production (or the Cloudflare
	// dashboard build env) so it's available during the build.
	// It must include the full API path, e.g.:
	//   https://api.<your-backend-domain>/api/v1/invoicely
	"vars": {
		"NEXT_PUBLIC_API_URL": "https://api.invoicely.shishirkhatri.com.np/api/v1/invoicely"
	}
}
