# Invoicely backend environment.
# Copy this file to `.env` and fill in the values.

# PostgreSQL DSN (e.g. a Supabase connection string).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# HYPER (Arcademia) auth base URL.
# HYPER_API_URL=https://api.arcademia.app

# Origin of the frontend, used to build invite join links (/join?token=…).
# FRONTEND_URL=http://localhost:3000

# --- CORS / cookies (cross-domain deployment) -------------------------------
# List the exact frontend origin(s) that may call the API. With credentials
# (cookies) a wildcard "*" is NOT allowed — list each origin explicitly.
# Example for production where frontend and backend are on different domains:
#   CORS_ORIGINS=https://invoicely.pages.dev,https://invoicely.app
CORS_ORIGINS=http://localhost:3000

# Set COOKIE_CROSS_DOMAIN=true when the frontend and backend are on DIFFERENT
# registrable domains (e.g. invoicely.pages.dev vs api.invoicely.dev). This
# forces SameSite=None + Secure, which is required for the browser to send the
# session cookie cross-origin. Requires HTTPS in production.
# Leave unset (false) when they share a registrable domain (same root domain,
# different subdomains) or for local dev on localhost.
# COOKIE_CROSS_DOMAIN=true

# Forces the Secure flag on the cookie (HTTPS only). Implied by
# COOKIE_CROSS_DOMAIN. Leave false for local dev over http.
# COOKIE_SECURE=true

# Cookie name / optional shared domain / max age (seconds).
# COOKIE_NAME=invoicely_session
# COOKIE_DOMAIN=.invoicely.app   # only when frontend+backend share a parent domain
# COOKIE_MAX_AGE=2592000

# Legacy header-key auth (old GET /auth route). Unset = endpoint disabled.
# LEGACY_ACCESS_KEY=change-me

# Rate limiting (per IP). Defaults shown.
# RATELIMIT_LOGIN=10
# RATELIMIT_LOGIN_WINDOW=60
# RATELIMIT_JOIN=5
# RATELIMIT_JOIN_WINDOW=60
